  "classification": {
    "mountain": {
      "label": "Mountain",
      "description": "Terrain dominated by elevated relief and significant local elevation change."
    },
    "fold_mountain": {
      "label": "Fold Mountain",
      "description": "Mountain terrain primarily associated with compressional deformation."
    },
    "volcanic": {
      "label": "Volcanic",
      "description": "Terrain associated with volcanic construction, lava flows or volcanic uplift."
    },
    "plateau": {
      "label": "Plateau",
      "description": "Elevated terrain with broad relatively level surfaces."
    },
    "escarpment": {
      "label": "Escarpment",
      "description": "Long steep slope separating different elevations or geological surfaces."
    },
    "fault_block": {
      "label": "Fault-Block",
      "description": "Mountain terrain created primarily through faulting and crustal uplift."
    },
    "ancient_fold": {
      "label": "Ancient Fold",
      "description": "Old mountain systems substantially reduced by long-term erosion."
    }
  },

